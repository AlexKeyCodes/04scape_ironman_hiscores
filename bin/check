#!/bin/bash

# Runs the same checks as the GitHub Actions CI flow (.github/workflows/ci.yml).

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print section headers
print_section() {
    echo -e "\n${YELLOW}=== $1 ===${NC}\n"
}

# Function to check if a command succeeded
check_status() {
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✓ $1 passed${NC}"
        return 0
    else
        echo -e "${RED}✗ $1 failed${NC}"
        return 1
    fi
}

# Start time
start_time=$(date +%s)

# Run Brakeman
print_section "Running Brakeman Security Scan"
bin/brakeman --no-pager
check_status "Brakeman" || exit 1

# Run Bundler Audit
print_section "Running Bundler Audit Gem Scan"
bin/bundler-audit
check_status "Bundler Audit" || exit 1

# Run Importmap Audit
print_section "Running Importmap JavaScript Audit"
bin/importmap audit
check_status "Importmap Audit" || exit 1

# Run Rubocop
print_section "Running Rubocop Style Check"
bin/rubocop
check_status "Rubocop" || exit 1

# Run RSpec
print_section "Running RSpec Tests"
bin/rails db:test:prepare && bundle exec rspec
check_status "RSpec" || exit 1

# Calculate and display total time
end_time=$(date +%s)
duration=$((end_time - start_time))
echo -e "\n${GREEN}✓ All checks completed in ${duration} seconds${NC}"
